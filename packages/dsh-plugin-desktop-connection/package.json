{
  "name": "dsh-plugin-desktop-connection",
  "version": "0.1.3",
  "private": true,
  "description": "DSH Desktop renderer connection: official node half re-export + Electron IPC client carrier",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "lib/**",
    "dist/**",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/verify-upstream.mts && tsc -p tsconfig.build.json && node scripts/build-client.mts",
    "verify:upstream": "node scripts/verify-upstream.mts",
    "test": "node --test tests/*.spec.ts",
    "check": "pnpm run build && tsc -p tsconfig.json && pnpm run test"
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-connection": "next",
    "@deepseek-ai/dsh-host-apiproxy": "next"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "latest",
    "@types/node": "^24.13.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.2"
  }
}
