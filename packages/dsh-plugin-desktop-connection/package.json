{
  "name": "dsh-plugin-desktop-connection",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Desktop renderer connection: official node half re-export + Electron IPC client carrier",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "lib/**/*.js",
    "src/**/*.js",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test tests/*.spec.js",
    "check": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-apiproxy": "0.1.0-rc.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "esbuild": "^0.25.0"
  }
}
