{
  "name": "dsh-plugin-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Desktop — virtual-webserver interceptor spike plugin",
  "license": "MIT",
  "author": "DeepSeek AI",
  "homepage": "https://github.com/deepseek-ai/deepseek-harness",
  "type": "module",
  "exports": {
    ".": "./lib/src/index.js",
    "./webserver": "./lib/src/webserver.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots",
        "locale"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mts",
    "build:client": "node scripts/build-client.mts",
    "test": "node --test tests/*.spec.ts",
    "verify:boot": "pnpm run build:client && node --test tests/*.spec.ts",
    "verify:packaged": "node scripts/verify-packaged-boot.mts",
    "start": "electron .",
    "check": "pnpm run build && tsc -p tsconfig.json && pnpm run test",
    "package:prepare": "pnpm run build && node scripts/materialize.mts",
    "package:dir": "node scripts/dist.mts --dir",
    "dist:mac": "node scripts/dist.mts --mac",
    "dist:win": "node scripts/dist.mts --win --x64",
    "dist:linux": "node scripts/dist.mts --linux"
  },
